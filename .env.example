# ─── Your music ──────────────────────────────────────────────────────────────
# Folder on this machine holding your MP3s. Mounted read-only into the backend.
MUSIC_DIR=./music

# ─── Published ports ─────────────────────────────────────────────────────────
# Change these if something else on the machine already uses 3000 or 8080.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ─── Addresses as the browser sees them ──────────────────────────────────────
# BASE_URL is what the backend puts into the stream URLs it hands to the page,
# so it must be reachable from the browser rather than from inside the network.
# Keep the port here in sync with BACKEND_PORT above.
BASE_URL=http://localhost:8080

# Where the page should look for the backend. Leave empty to use the host that
# served the page on port 8080, which is correct for the default layout. Set it
# when the backend is on another host or behind TLS, e.g. https://radio.example.com
BACKEND_URL=

# ─── Frontend build options (docker-compose.yml only) ────────────────────────
# Compiles a backend URL into the bundle. Normally leave this empty and use
# BACKEND_URL above, which needs no rebuild.
VITE_BACKEND_URL=

# Start audio without waiting for a click. Overlay routes do this anyway when
# they detect OBS; the main page can also opt in with ?autoplay=1
VITE_AUTO_START_AUDIO=false

# ─── Publishing (docker-compose.build.yml / docker-compose.hub.yml) ──────────
DOCKERHUB_NAMESPACE=worxbend
IMAGE_TAG=latest
